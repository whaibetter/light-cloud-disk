{
  "name": "light-cloud-disk-uniapp",
  "version": "2.0.0",
  "description": "轻量云盘 - 基于Uni-app的跨平台应用",
  "scripts": {
    "dev:h5": "uni -p h5",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app-android": "uni -p app-android",
    "build:h5": "uni build -p h5",
    "build:app": "uni build -p app",
    "build:app-android": "uni build -p app-android",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5000820260430001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5000820260430001",
    "@dcloudio/uni-components": "3.0.0-alpha-5000820260430001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5000820260430001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5000820260430001",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5000820260430001",
    "@dcloudio/uni-automator": "3.0.0-alpha-5000820260430001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5000820260430001",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "prettier": "^3.2.5",
    "sass": "^1.72.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
